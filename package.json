{"name":"navalha-saas","private":true,"workspaces":["apps/*"],"scripts":{"dev":"concurrently -n API,WEB -c yellow,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"","build":"npm run build -w apps/api && npm run build -w apps/web","test":"npm run test -w apps/api","lint":"eslint apps --max-warnings=0","lint:fix":"npm run lint -- --fix","format":"prettier --write \"{apps,docs}/**/*.{ts,tsx,css,md,json}\" \"*.{json,md,yml}\"","format:check":"prettier --check \"{apps,docs}/**/*.{ts,tsx,css,md,json}\" \"*.{json,md,yml}\"","validate":"npm run lint && npm run test && npm run build","db:generate":"npm run db:generate -w apps/api","db:migrate":"npm run db:migrate -w apps/api","db:seed":"npm run db:seed -w apps/api"},"devDependencies":{"@eslint/js":"^9.35.0","concurrently":"^9.1.2","eslint":"^9.35.0","eslint-plugin-react-hooks":"^5.2.0","eslint-plugin-react-refresh":"^0.4.20","globals":"^16.3.0","prettier":"^3.6.2","typescript-eslint":"^8.42.0"}}
